# Copy to .env (same folder as docker-compose.yml). Never commit the real .env.
TMDB_API_KEY=
# Optional: paid UPCitemdb key. Without it, barcode lookups use the free tier.
UPCITEMDB_USER_KEY=
SECRET_KEY=change-me-to-a-long-random-string
# Forgot-password emails. APP_URL is the site's public address (used in the link).
APP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
